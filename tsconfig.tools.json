{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "packages/*/*.config.ts"
  ]
}
